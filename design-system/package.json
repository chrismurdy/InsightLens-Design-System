{
  "name": "@insightlens/design-system",
  "version": "0.1.0",
  "description": "InsightLens by Envision USA — design tokens and React component library.",
  "type": "module",
  "main": "./dist/insightlens-design-system.cjs",
  "module": "./dist/insightlens-design-system.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/insightlens-design-system.js",
      "require": "./dist/insightlens-design-system.cjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src/assets"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
